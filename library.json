{
  "name": "ILI9341_GFX",
  "version": "1.0.1",
  "description": "Fast ILI9341 SPI driver for the ESP32, compatible with Adafruit_GFX: register-level DMA driver, hardware D/C via SPI dual output, framebuffer with dirty-region updates, tear-free VSync and hardware scrolling",
  "keywords": "ili9341, tft, display, adafruit_gfx, spi, dma, esp32, framebuffer, vsync",
  "repository": {
    "type": "git",
    "url": "https://github.com/JKBusse/ILI9341_GFX.git"
  },
  "homepage": "https://github.com/JKBusse/ILI9341_GFX",
  "authors": [
    {
      "name": "JKBusse",
      "url": "https://github.com/JKBusse",
      "maintainer": true
    }
  ],
  "license": "MIT",
  "frameworks": "arduino",
  "platforms": "*",
  "dependencies": [
    {
      "name": "Adafruit GFX Library",
      "owner": "adafruit",
      "version": "^1.11.9"
    }
  ],
  "headers": [
    "ILI9341_GFX.h",
    "ILI9341_Framebuffer.h"
  ],
  "examples": [
    "examples/*/*.ino"
  ],
  "export": {
    "exclude": [
      "extras/bench",
      "extras/demo",
      "extras/test",
      "extras/tools",
      "extras/videostream",
      ".vscode",
      "platformio.ini"
    ]
  }
}
